function izris(Pp,Q,D,Dr,d,Rs,Rrz,hpc,bdr,ar,br,Ndc,hsz,hs,hys,b1,b2,bdss,bds,fizob,Zq,Idc,m,Is1,Is2,Is3,alfa,Rpc,angle1)

Rr=Dr/2;
segments=10;
angle=360/(Pp*2*2); %stopinje
anglepi=angle*pi*2/360;

Automesh=0;
Meshsize=0;

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ROTOR

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% izris gredi
mi_addnode(0, 0);
mi_drawarc(Rs*sin(anglepi),Rs*cos(anglepi),-Rs*sin(anglepi),Rs*cos(anglepi), 2*angle, segments);
mi_drawline(0, 0,Rs*sin(anglepi),Rs*cos(anglepi));
mi_drawline(0, 0,-Rs*sin(anglepi),Rs*cos(anglepi));

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% izris zeleznega dela rotorja
mi_addnode(-bdr/2, Rrz);
mi_addnode(bdr/2, Rrz);
%mi_drawline(-bdr/2, Rrz,bdr/2, Rrz);

mi_addnode(Rrz*tan(pi/(2*Pp)), Rrz);
mi_addnode(-Rrz*tan(pi/(2*Pp)), Rrz);
mi_drawline(-Rrz*tan(pi/(2*Pp)), Rrz,-bdr/2, Rrz);
mi_drawline(Rrz*tan(pi/(2*Pp)), Rrz,bdr/2, Rrz);

mi_drawline(-Rrz*tan(pi/(2*Pp)), Rrz,-Rs*sin(anglepi),Rs*cos(anglepi));
mi_drawline(Rrz*tan(pi/(2*Pp)), Rrz,Rs*sin(anglepi),Rs*cos(anglepi));

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% izris pola
mi_addnode(-bdr/2,Rrz);
mi_addnode(bdr/2,Rrz);

mi_addnode(-bdr/2,Rrz+br);
mi_addnode(bdr/2,Rrz+br);

mi_drawline(-bdr/2,Rrz,-bdr/2,Rrz+br);
mi_drawline(bdr/2,Rrz,bdr/2,Rrz+br);
%mi_drawline(-bdr/2,Rrz+br,bdr/2,Rrz+br);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% izris polovega cevlja
mi_addnode(-bdr/2-ar,Rrz+br);
mi_addnode(bdr/2+ar,Rrz+br);

mi_drawline(-bdr/2,Rrz+br,-bdr/2-ar,Rrz+br);
mi_drawline(bdr/2,Rrz+br,bdr/2+ar,Rrz+br);

x=Rpc*tan(pi*alfa/(2*Pp));

mi_addnode(-x,Rrz+br);
mi_addnode(x,Rrz+br);

mi_drawline(-x,Rrz+br,-bdr/2-ar,Rrz+br);
mi_drawline(x,Rrz+br,bdr/2+ar,Rrz+br);

mi_addnode(0,Rr);

mi_drawarc(0,Rr,-x,Rrz+br, angle1, segments);
mi_drawarc(x,Rrz+br,0,Rr, angle1, segments);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% izris navitja
mi_drawline(-bdr/2-ar,Rrz+br,-bdr/2-ar,Rrz);
mi_drawline(bdr/2+ar,Rrz+br,bdr/2+ar,Rrz);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% opis materialov Rotorja

%Gred
mi_getmaterial('416 Stainless Steel');
mi_addblocklabel(0,Rs/2);
mi_selectlabel(0,Rs/2);
mi_setblockprop('416 Stainless Steel', Automesh, Meshsize, 0, 0, 0, 0);
mi_clearselected();

%zelezni del rotorja
mi_getmaterial('M330-35A');
mi_addblocklabel(0,Rs+d);
mi_selectlabel(0,Rs+d);
mi_setblockprop('M330-35A', Automesh, Meshsize, 0, 0, 0, 0);
mi_clearselected();

% %Pol rotorja
% mi_getmaterial('M330-35A');
% mi_addblocklabel(0,Rrz+br/2);
% mi_selectlabel(0,Rrz+br/2);
% mi_setblockprop('M330-35A', 1, 0, 0, 0, 0, 0);
% mi_clearselected();
% 
% %Polov cevel rotorja
% mi_getmaterial('M330-35A');
% mi_addblocklabel(0,Rrz+br+hpc/2);
% mi_selectlabel(0,Rrz+br+hpc/2);
% mi_setblockprop('M330-35A', 1, 0, 0, 0, 0, 0);
% mi_clearselected();

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Koperanje rotorja
mi_selectrectangle(-Rr,-Rr,Rr,Rr,4); % 4 indicates selection of nodes
mi_copyrotate2(0, 0, 360/(2*Pp), 2*Pp,4);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% definicija DC vezija in posavitev

mi_addcircprop('NavitjeDC', Idc, 1);

i=1;
k=1;
while i<=2*Pp

x=(bdr/2+ar/2);
y=(Rrz+br/2);
alfa=pi/Pp*(i-1);

%Polov cevel rotorja
mi_getmaterial('Copper');
mi_addblocklabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
mi_selectlabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
mi_setblockprop('Copper', 1, 0, 'NavitjeDC', 0, 0, k*Ndc);
mi_clearselected();

x=x*-1;

%Polov cevel rotorja
mi_getmaterial('Copper');
mi_addblocklabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
mi_selectlabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
mi_setblockprop('Copper', 1, 0, 'NavitjeDC', 0, 0, k*-Ndc);
mi_clearselected();

i=i+1;
k=k*-1;
end

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% STATOR

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Izris stat zoba

%Izris spodnjega dela zoba
angle2pi=pi*(2*pi*(Rr+d)/Q-b1)/(2*pi*(Rr+d));
angle2=angle2pi*360/(2*pi);

x1=-(Rr+d)*sin(angle2pi);
y1=(Rr+d)*cos(angle2pi);

mi_addnode(-(Rr+d)*sin(angle2pi),(Rr+d)*cos(angle2pi));
mi_drawarc(-x1,y1,x1,y1, 2*angle2, segments);

%izris b2
x2=x1;
y2=y1+b2;

mi_addnode(x2,y2);
mi_addnode(-x2,y2);
mi_drawline(x1,y1,x2,y2);
mi_drawline(-x1,y1,-x2,y2);

%izris fizob
x3=-bds/2;
y3=Rr+d+b2+tan(fizob)*((bdss-bds)/2);

mi_addnode(x3,y3);
mi_addnode(-x3,y3);
mi_drawline(x2,y2,x3,y3);
mi_drawline(-x2,y2,-x3,y3);

%izris zgorjega dela zoba
x4=x3;
y4=Rr+d+b2+hs;

mi_addnode(x4,y4);
mi_addnode(-x4,y4);
mi_drawline(x3,y3,x4,y4);
mi_drawline(-x3,y3,-x4,y4);
%mi_drawline(-x4,y4,x4,y4);

%izris zgornjega dela utora
x5=-y4*sin(pi/Q);
y5=y4*cos(pi/Q);

mi_addnode(x5,y5);
mi_addnode(-x5,y5);
mi_drawline(x4,y4,x5,y5);
mi_drawline(-x4,y4,-x5,y5);

%izriz povezave med zobi
Ry=Rr+d+b2;
x6=-Ry*sin(pi/Q);
y6=Ry*cos(pi/Q);

mi_addnode(x6,y6);
mi_addnode(-x6,y6);
mi_drawline(x2,y2,x6,y6);
mi_drawline(-x2,y2,-x6,y6);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%Izris jarma
Ry=Rr+d+hsz+hys;
mi_drawarc(Ry*sin(pi/Q),Ry*cos(pi/Q),-Ry*sin(pi/Q),Ry*cos(pi/Q),360/Q, segments);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% % Koperanje statorja
mi_selectrectangle(-Rr,Rr+d/4,Rr,D,4); % 4 indicates selection of nodes
mi_copyrotate2(0, 0, 360/Q, Q,4);

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% opis materialov Stator

%material jarma
mi_getmaterial('M330-35A');
mi_addblocklabel(0,Rr+d+hsz+hys/2);
mi_selectlabel(0,Rr+d+hsz+hys/2);
mi_setblockprop('M330-35A', 1, 0, 0, 0, 0, 0);
mi_clearselected();

% %zob
% mi_getmaterial('M330-35A');
% mi_addblocklabel(0,Rr+d+hsz/2);
% mi_selectlabel(0,Rr+d+hsz/2);
% mi_setblockprop('M330-35A', 1, 0, 0, 0, 0, 0);
% mi_clearselected();

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% definicija AC vezij in posavitev

%Navitje 1
mi_addcircprop('NavitjeAC1', Is1, 1);

P=Q/(m*2*Pp);

ii=1;
while ii<=Pp
alfa1=2*pi/Pp*(ii-1);

    i=0;
    while i<P
        y=Rr+d+hs/2;
        x=-(pi*y/Q);
        alfa=2*pi/Q*(i-1)+alfa1;

        %Navitja 1+
        mi_getmaterial('Copper');
        mi_addblocklabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_selectlabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_setblockprop('Copper', 1, 0, 'NavitjeAC1', 0, 0, Zq);
        mi_clearselected();

        alfa=2*pi/Q*(i-1+m*P)+alfa1;

        %Navitje 1-
        mi_getmaterial('Copper');
        mi_addblocklabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_selectlabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_setblockprop('Copper', 1, 0, 'NavitjeAC1', 0, 0, -Zq);
        mi_clearselected();

        i=i+1;
    end
ii=ii+1;
end

%Navitje 2
mi_addcircprop('NavitjeAC2', Is2, 1);

ii=1;
while ii<=Pp
alfa1=2*pi/Pp*(ii-1);

    i=0+P;
    while i<P+P
        y=Rr+d+hs/2;
        x=-(pi*y/Q);
        alfa=2*pi/Q*(i-1)+alfa1;

        %Navitja 2+
        mi_getmaterial('Copper');
        mi_addblocklabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_selectlabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_setblockprop('Copper', 1, 0, 'NavitjeAC2', 0, 0, -Zq);
        mi_clearselected();

        alfa=2*pi/Q*(i-1+m*P)+alfa1;

        %Navitje 2-
        mi_getmaterial('Copper');
        mi_addblocklabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_selectlabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_setblockprop('Copper', 1, 0, 'NavitjeAC2', 0, 0, Zq);
        mi_clearselected();

        i=i+1;
    end
ii=ii+1;
end

%Navitje 3
mi_addcircprop('NavitjeAC3', Is3, 1);

ii=1;
while ii<=Pp
alfa1=2*pi/Pp*(ii-1);

    i=0+P+P;
    while i<P+P+P
        y=Rr+d+hs/2;
        x=-(pi*y/Q);
        alfa=2*pi/Q*(i-1)+alfa1;

        %Navitja 3+
        mi_getmaterial('Copper');
        mi_addblocklabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_selectlabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_setblockprop('Copper', 1, 0, 'NavitjeAC3', 0, 0, Zq);
        mi_clearselected();

        alfa=2*pi/Q*(i-1+m*P)+alfa1;

        %Navitje 3-
        mi_getmaterial('Copper');
        mi_addblocklabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_selectlabel(x*cos(alfa)-y*sin(alfa),x*sin(alfa)+y*cos(alfa));
        mi_setblockprop('Copper', 1, 0, 'NavitjeAC3', 0, 0, -Zq);
        mi_clearselected();

        i=i+1;
    end
ii=ii+1;
end

%Material Zračne reže
mi_getmaterial('Air');
mi_addblocklabel(0,Rr+d/2);
mi_selectlabel(0,Rr+d/2);
mi_setblockprop('Air', 1, 0, 0, 0, 0, 0);
mi_clearselected();

mi_drawarc(0,1.1*D/2,0,-1.1*D/2, 180, segments);
mi_drawarc(0,-1.1*D/2,0,1.1*D/2, 180, segments);

%Material Zrak okoli stroja
mi_getmaterial('Air');
mi_addblocklabel(0,D/2+d);
mi_selectlabel(0,D/2+d);
mi_setblockprop('Air', 1, 0, 0, 0, 0, 0);
mi_clearselected();
